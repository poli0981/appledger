root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
[*.{yml,yaml,json,md}]
indent_size = 2
[*.md]
trim_trailing_whitespace = false
[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
dotnet_diagnostic.CA1062.severity = none
[*.xaml]
indent_size = 4

# Test and spike projects only.
[{tests,spikes}/**/*.cs]
# docs/19_TESTING.md mandates Method_Scenario_Expectation test names, which CA1707 forbids.
dotnet_diagnostic.CA1707.severity = none
# Fixture builders and harnesses legitimately use literal paths and hand-rolled helpers.
dotnet_diagnostic.CA1861.severity = none
