<Project Sdk="Microsoft.NET.Sdk">
  <!-- S1-lite / S1 harness. docs/20_SPIKES.md. Throw-away by design: nothing under src/ may reference it,
       and it is deliberately absent from AppLedger.slnx so CI never builds it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <RootNamespace>S1.EtwBudget</RootNamespace>
    <AssemblyName>S1.EtwBudget</AssemblyName>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
