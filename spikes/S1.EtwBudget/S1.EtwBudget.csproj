<Project Sdk="Microsoft.NET.Sdk">
  <!-- S1-lite / S1 harness. docs/20_SPIKES.md. Throw-away by design: nothing under src/ may reference it,
       and it is deliberately absent from AppLedger.slnx so CI never builds it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <RootNamespace>S1.EtwBudget</RootNamespace>
    <AssemblyName>S1.EtwBudget</AssemblyName>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- docs/17_BUILD.md §Projects and TFMs: spikes reference Collector/Infrastructure. The Agent is an exe
         and is deliberately not referenced. The point of the hours leg is that it measures the pipeline
         without the pipe server, Serilog or the catalog, and the difference from the Agent's own numbers is
         what those three cost. -->
    <ProjectReference Include="..\..\src\AppLedger.Collector\AppLedger.Collector.csproj" />
    <ProjectReference Include="..\..\src\AppLedger.Infrastructure\AppLedger.Infrastructure.csproj" />
  </ItemGroup>
</Project>
