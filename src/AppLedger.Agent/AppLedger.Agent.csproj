<Project Sdk="Microsoft.NET.Sdk">
  <!-- AppLedger.Agent.exe — elevated worker host (Generic Host): collector + pipe server + scheduled-task installer.
       Console output type so the status/console switches can print; the Scheduled Task runs it below-normal priority. docs/01, 05, 16 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>AppLedger.Agent</RootNamespace>
    <AssemblyName>AppLedger.Agent</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- The task definition is embedded, not shipped as a file: the install folder is user-writable, and an
         elevated process reading the definition it is about to register from there would be a real hole. -->
    <EmbeddedResource Include="Tasks/AppLedgerAgentTask.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AppLedger.Core\AppLedger.Core.csproj" />
    <ProjectReference Include="..\AppLedger.Ipc\AppLedger.Ipc.csproj" />
    <ProjectReference Include="..\AppLedger.Collector\AppLedger.Collector.csproj" />
    <ProjectReference Include="..\AppLedger.Infrastructure\AppLedger.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
