<Project Sdk="Microsoft.NET.Sdk">
  <!-- AppLedger.exe — WPF UI (standard user). WPF-UI 4.3.0 shell + ScottPlot 5. docs/08_UI.md, docs/22_WPFUI_SYNTAX.md -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>AppLedger.App</RootNamespace>
    <AssemblyName>AppLedger</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- en is the source of truth for resx (docs/14_I18N.md); vi and ja are satellites. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <!-- The navigation smoke test asserts every page named in MainWindow.xaml is registered in the
         container. A missing registration throws the first time a user clicks that rail item, not at build
         time (docs/22_WPFUI_SYNTAX.md §Gotchas), so the test needs to see ConfigureServices. -->
    <InternalsVisibleTo Include="AppLedger.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AppLedger.Core\AppLedger.Core.csproj" />
    <ProjectReference Include="..\AppLedger.Ipc\AppLedger.Ipc.csproj" />
    <ProjectReference Include="..\AppLedger.Collector\AppLedger.Collector.csproj" />   <!-- Lite mode hosts the collector in-proc -->
    <ProjectReference Include="..\AppLedger.Infrastructure\AppLedger.Infrastructure.csproj" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="WPF-UI.DependencyInjection" />
    <PackageReference Include="ScottPlot.WPF" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The resx files are embedded as resources; the strongly-typed Strings class beside them is generated
         by tools/gen-strings.py and committed.

         Not the SDK's StronglyTypedFileName: written into obj it is produced during PrepareResources, after
         the Compile items were evaluated, so a *clean* build generates it and never compiles it while a
         second build succeeds - green locally, red on CI, which always builds clean. Written into the
         project directory the SDK declined to produce it at all. A committed file that a script regenerates
         and a test verifies is the version with no MSBuild ordering in it. docs/14_I18N.md. -->
    <EmbeddedResource Update="Resources\Strings.resx" />
  </ItemGroup>
</Project>
