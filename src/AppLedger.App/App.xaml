<Application x:Class="AppLedger.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="Views/MainWindow.xaml">
    <!--  TODO(kickoff): v0.2 replaces StartupUri with the Generic Host + ApplicationHostService  -->
    <!--  bootstrap from docs/22_WPFUI_SYNTAX.md §Bootstrap, and adds Styles/ChartPalette.xaml.   -->
    <!--  Dictionary order below is a hard rule: ThemesDictionary -> ControlsDictionary -> app.   -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
