<Application
    x:Class="AppLedger.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    DispatcherUnhandledException="OnDispatcherUnhandledException">
    <!--
        No StartupUri: the window is created and shown by ApplicationHostService once the Generic Host has
        built the graph it needs (docs/22_WPFUI_SYNTAX.md §Bootstrap).

        Dictionary order is a hard rule. ThemesDictionary and ControlsDictionary must come first, or every
        WPF-UI control renders with its default template and the whole shell looks unstyled - with no error
        anywhere to say why.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Styles/ChartPalette.xaml" />
                <ResourceDictionary Source="Styles/AppLedger.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
