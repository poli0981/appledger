<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The one place in this application where a colour may be written as a hex literal
        (docs/22_WPFUI_SYNTAX.md §Theme and brushes). Everything else uses theme brushes through
        DynamicResource, because a chart series has no Fluent equivalent to inherit from: the palette has to
        stay stable across a theme switch or the same app changes colour when the user changes theme, and a
        chart the user cannot re-identify between sessions is worse than one that clashes slightly.

        Series colours are chosen to stay distinguishable in both themes and to survive the two most common
        forms of colour blindness; they are deliberately not the accent colour, which the user can change.
    -->

    <Color x:Key="ChartSeriesCpuColor">#4C8DFF</Color>
    <Color x:Key="ChartSeriesMemoryColor">#8B5CF6</Color>
    <Color x:Key="ChartSeriesDiskColor">#F59E0B</Color>
    <Color x:Key="ChartSeriesNetworkColor">#10B981</Color>
    <Color x:Key="ChartSeriesGpuColor">#EC4899</Color>

    <SolidColorBrush x:Key="ChartSeriesCpuBrush" Color="{StaticResource ChartSeriesCpuColor}" />
    <SolidColorBrush x:Key="ChartSeriesMemoryBrush" Color="{StaticResource ChartSeriesMemoryColor}" />
    <SolidColorBrush x:Key="ChartSeriesDiskBrush" Color="{StaticResource ChartSeriesDiskColor}" />
    <SolidColorBrush x:Key="ChartSeriesNetworkBrush" Color="{StaticResource ChartSeriesNetworkColor}" />
    <SolidColorBrush x:Key="ChartSeriesGpuBrush" Color="{StaticResource ChartSeriesGpuColor}" />

    <!--
        Degraded minutes are hatched rather than dropped, so a gap the collector knows about looks different
        from a gap it does not (docs/01_ARCHITECTURE.md §Degraded modes).
    -->
    <Color x:Key="ChartDegradedColor">#6B7280</Color>
    <SolidColorBrush x:Key="ChartDegradedBrush" Color="{StaticResource ChartDegradedColor}" Opacity="0.35" />

</ResourceDictionary>
