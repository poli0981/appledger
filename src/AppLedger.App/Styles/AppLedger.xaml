<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Application styles. Colours here come only from WPF-UI theme brushes through DynamicResource:
        a StaticResource on a theme brush is a review-blocking bug, because it resolves once and then keeps
        the colour of whichever theme happened to be active at load (docs/22_WPFUI_SYNTAX.md).
    -->

    <Thickness x:Key="PageMargin">24,16,24,24</Thickness>
    <Thickness x:Key="CardMargin">0,0,0,12</Thickness>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PageBodyStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
