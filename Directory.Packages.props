<Project>
  <!--
    Central Package Management. Versions marked [checked 2026-08-22] were verified on NuGet
    when this suite was written. Everything else: verify at kickoff, then let Dependabot keep
    them current. Every pin here was re-verified against nuget.org on 2026-08-23 (kickoff);
    `Microsoft.CodeAnalysis.BannedApiAnalyzers 3.11.0` did not exist and was corrected - docs/24_ADR.md.
    WPF-UI stays pinned at exactly 4.3.0 (4.0.0-4.0.3, 4.1.0, 4.2.0 are deprecated
    on NuGet for critical bugs - see docs/22_WPFUI_SYNTAX.md).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="WPF-UI" Version="[4.3.0]" />                                  <!-- [checked 2026-08-22] pinned -->
    <PackageVersion Include="WPF-UI.DependencyInjection" Version="[4.3.0]" />
    <PackageVersion Include="ScottPlot.WPF" Version="5.1.59" />                             <!-- [checked 2026-08-22] -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Hosting / logging -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Serilog" Version="4.3.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <!-- Data -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <!-- Transitive pins: Microsoft.Data.Sqlite 10.0.9 resolves SQLitePCLRaw 2.1.11, which carries
         GHSA-2m69-gcr7-jv3q (high). Lifted via CentralPackageTransitivePinningEnabled. docs/24_ADR.md. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />   <!-- [checked 2026-08-23] -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.13" />
    <!-- Windows / collection -->
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.4" />  <!-- [checked 2026-08-22] -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.298" />                      <!-- [checked 2026-08-22] -->
    <PackageVersion Include="MaxMind.Db" Version="4.2.0" />
    <PackageVersion Include="NSec.Cryptography" Version="25.4.0" />                           <!-- minisign verification (docs/13) -->
    <!-- Packaging -->
    <PackageVersion Include="Velopack" Version="1.2.0" />                                   <!-- [checked 2026-08-22] -->
    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />  <!-- [checked 2026-08-23] 3.11.0 is prerelease-only -->
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
